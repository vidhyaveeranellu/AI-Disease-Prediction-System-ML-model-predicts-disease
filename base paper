        "\n",
        "drive.mount(\"/content/drive\")\n",
        "\n",
        "# ============================================================\n",
        "# 3. CONFIGURATION\n",
        "# ============================================================\n",
        "\n",
        "# Your exact dataset path\n",
        "DATA_DIR = \"/content/drive/MyDrive/Database/Database/Images\"\n",
        "\n",
        "# Image size specified in the base paper\n",
        "IMAGE_SIZE = 200\n",
        "\n",
        "# Batch size\n",
        "BATCH_SIZE = 16\n",
