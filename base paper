      "source": [
        "# ============================================================\n",
        "# COMPLETE PYTORCH CODE\n",
        "# ACRIMA GLAUCOMA CLASSIFICATION\n",
        "# DATASET LABELS ARE CREATED FROM \"_g_\" IN THE FILENAME\n",
        "# ============================================================\n",
        "\n",
        "# Install packages\n",
        "!pip install -q torch torchvision scikit-learn matplotlib seaborn pillow pandas\n",
        "\n",
        "# ============================================================\n",
        "# 1. IMPORT LIBRARIES\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import random\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "from PIL import Image\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "\n",
        "from torchvision import transforms\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import (\n",
        "    confusion_matrix,\n",
        "    classification_report,\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    roc_auc_score\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 2. MOUNT GOOGLE DRIVE\n",
        "# ============================================================\n",
        "\n",
        "from google.colab import drive\n",
        "\n",
        "drive.mount(\"/content/drive\")\n",
        "\n",
        "# ============================================================\n",
        "# 3. CONFIGURATION\n",
        "# ============================================================\n",
        "\n",
        "# Your exact dataset path\n",
        "DATA_DIR = \"/content/drive/MyDrive/Database/Database/Images\"\n",
        "\n",
        "# Image size specified in the base paper\n",
        "IMAGE_SIZE = 200\n",
        "\n",
        "# Batch size\n",
        "BATCH_SIZE = 16\n",
        "\n",
        "# Change this to 100 for the second experiment\n",
        "EPOCHS = 50\n",
        "\n",
        "# Learning rate specified in the base paper\n",
        "LEARNING_RATE = 0.0001\n",
        "\n",
        "# Dropout value\n",
        "DROPOUT_RATE = 0.5\n",
        "\n",
        "# Base-paper filter configuration\n",
        "FILTERS = [16, 32, 64]\n",
        "\n",
        "# The paper mentions threshold = 0.9.\n",
        "# Use 0.5 for standard binary classification.\n",
        "# Change to 0.9 for the paper threshold experiment.\n",
        "THRESHOLD = 0.9\n",
        "\n",
        "# Validation ratio\n",
        "VALIDATION_RATIO = 0.05\n",
        "\n",
        "# Random seed\n",
        "SEED = 42\n",
        "\n",
        "# Use GPU if available\n",
        "DEVICE = torch.device(\n",
        "    \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        ")\n",
        "\n",
        "print(\"Device:\", DEVICE)\n",
        "print(\"Dataset path:\", DATA_DIR)\n",
        "print(\"Dataset path exists:\", os.path.exists(DATA_DIR))\n",
        "\n",
        "if not os.path.exists(DATA_DIR):\n",
        "    raise FileNotFoundError(\n",
        "        f\"Dataset folder not found: {DATA_DIR}\"\n",
        "    )\n",
        "\n",
        "# ============================================================\n",
        "# 4. REPRODUCIBILITY\n",
        "# ============================================================\n",
        "\n",
        "def set_seed(seed=42):\n",
        "    random.seed(seed)\n",
        "    np.random.seed(seed)\n",
        "    torch.manual_seed(seed)\n",
        "\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.manual_seed(seed)\n",
        "        torch.cuda.manual_seed_all(seed)\n",
        "\n",
        "    torch.backends.cudnn.deterministic = True\n",
        "    torch.backends.cudnn.benchmark = False\n",
        "\n",
        "\n",
        "set_seed(SEED)\n",
        "\n",
        "# ============================================================\n",
        "# 5. CREATE RESULTS FOLDER\n",
        "# ============================================================\n",
        "\n",
        "RESULTS_DIR = \"/content/drive/MyDrive/ACRIMA_CNN_Results\"\n",
        "\n",
        "os.makedirs(\n",
        "    RESULTS_DIR,\n",
        "    exist_ok=True\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 6. LOAD DATASET USING FILENAME LABELS\n",
        "# ============================================================\n",
        "\n",
        "valid_extensions = (\n",
        "    \".jpg\",\n",
        "    \".jpeg\",\n",
        "    \".png\",\n",
        "    \".bmp\",\n",
        "    \".tif\",\n",
        "    \".tiff\"\n",
        ")\n",
        "\n",
        "data = []\n",
        "\n",
        "for filename in sorted(os.listdir(DATA_DIR)):\n",
        "\n",
        "    if filename.lower().endswith(valid_extensions):\n",
        "\n",
        "        filepath = os.path.join(\n",
        "            DATA_DIR,\n",
        "            filename\n",
        "        )\n",
        "\n",
        "        # ACRIMA filename rule:\n",
        "        # \"_g_\" means glaucoma\n",
        "        # otherwise normal\n",
        "        if \"_g_\" in filename.lower():\n",
        "            label = 1\n",
        "            class_name = \"glaucoma\"\n",
        "        else:\n",
        "            label = 0\n",
        "            class_name = \"normal\"\n",
        "\n",
        "        data.append({\n",
        "            \"filepath\": filepath,\n",
        "            \"label\": label,\n",
        "            \"class_name\": class_name,\n",
        "            \"filename\": filename\n",
        "        })\n",
        "\n",
        "if len(data) == 0:\n",
        "    raise ValueError(\n",
        "        \"No image files were found in DATA_DIR.\"\n",
        "    )\n",
        "\n",
        "dataframe = pd.DataFrame(data)\n",
        "\n",
        "print(\"\\nDataset summary:\")\n",
        "print(dataframe[\"class_name\"].value_counts())\n",
        "\n",
        "print(\"\\nTotal images:\", len(dataframe))\n",
        "print(\"Glaucoma images:\", int((dataframe[\"label\"] == 1).sum()))\n",
        "print(\"Normal images:\", int((dataframe[\"label\"] == 0).sum()))\n",
        "\n",
        "# Verify that both classes exist\n",
        "if dataframe[\"label\"].nunique() < 2:\n",
        "    raise ValueError(\n",
        "        \"Only one class was detected. Check the filename rule '_g_'.\"\n",
        "    )\n",
        "\n",
        "# ============================================================\n",
        "# 7. TRAIN-VALIDATION SPLIT\n",
        "# ============================================================\n",
        "\n",
        "train_dataframe, validation_dataframe = train_test_split(\n",
        "    dataframe,\n",
        "    test_size=VALIDATION_RATIO,\n",
        "    random_state=SEED,\n",
        "    stratify=dataframe[\"label\"]\n",
        ")\n",
        "\n",
        "train_dataframe = train_dataframe.reset_index(\n",
        "    drop=True\n",
        ")\n",
        "\n",
        "validation_dataframe = validation_dataframe.reset_index(\n",
        "    drop=True\n",
        ")\n",
        "\n",
        "print(\"\\nTraining images:\", len(train_dataframe))\n",
        "print(\"Validation images:\", len(validation_dataframe))\n",
        "\n",
        "print(\"\\nTraining class distribution:\")\n",
        "print(train_dataframe[\"class_name\"].value_counts())\n",
        "\n",
        "print(\"\\nValidation class distribution:\")\n",
        "print(validation_dataframe[\"class_name\"].value_counts())\n",
        "\n",
        "# ============================================================\n",
        "# 8. IMAGE TRANSFORMATIONS\n",
        "# ============================================================\n",
        "\n",
        "train_transforms = transforms.Compose([\n",
        "    transforms.Resize(\n",
        "        (IMAGE_SIZE, IMAGE_SIZE)\n",
        "    ),\n",
        "\n",
        "    transforms.RandomHorizontalFlip(\n",
        "        p=0.5\n",
        "    ),\n",
        "\n",
        "    transforms.RandomRotation(\n",
        "        degrees=10\n",
        "    ),\n",
        "\n",
        "    transforms.RandomAffine(\n",
        "        degrees=0,\n",
        "        translate=(0.05, 0.05),\n",
        "        scale=(0.95, 1.05)\n",
        "    ),\n",
        "\n",
        "    transforms.ColorJitter(\n",
        "        brightness=0.10,\n",
        "        contrast=0.10\n",
        "    ),\n",
        "\n",
        "    transforms.ToTensor(),\n",
        "\n",
        "    transforms.Normalize(\n",
        "        mean=[0.485, 0.456, 0.406],\n",
        "        std=[0.229, 0.224, 0.225]\n",
        "    )\n",
        "])\n",
        "\n",
        "validation_transforms = transforms.Compose([\n",
        "    transforms.Resize(\n",
        "        (IMAGE_SIZE, IMAGE_SIZE)\n",
        "    ),\n",
        "\n",
        "    transforms.ToTensor(),\n",
        "\n",
        "    transforms.Normalize(\n",
        "        mean=[0.485, 0.456, 0.406],\n",
        "        std=[0.229, 0.224, 0.225]\n",
        "    )\n",
        "])\n",
        "\n",
        "# ============================================================\n",
        "# 9. CUSTOM PYTORCH DATASET\n",
        "# ============================================================\n",
        "\n",
        "class ACRIMADataset(Dataset):\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        dataframe,\n",
        "        transform=None\n",
        "    ):\n",
        "        self.dataframe = dataframe.reset_index(\n",
        "            drop=True\n",
        "        )\n",
        "\n",
        "        self.transform = transform\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.dataframe)\n",
        "\n",
        "    def __getitem__(self, index):\n",
        "\n",
        "        image_path = self.dataframe.loc[\n",
        "            index,\n",
        "            \"filepath\"\n",
        "        ]\n",
        "\n",
        "        label = self.dataframe.loc[\n",
        "            index,\n",
        "            \"label\"\n",
        "        ]\n",
        "\n",
        "        image = Image.open(\n",
        "            image_path\n",
        "        ).convert(\"RGB\")\n",
        "\n",
        "        if self.transform is not None:\n",
        "            image = self.transform(image)\n",
        "\n",
        "        label = torch.tensor(\n",
        "            label,\n",
        "            dtype=torch.float32\n",
        "        )\n",
        "\n",
        "        return image, label\n",
        "\n",
        "\n",
        "train_dataset = ACRIMADataset(\n",
        "    dataframe=train_dataframe,\n",
        "    transform=train_transforms\n",
        ")\n",
        "\n",
        "validation_dataset = ACRIMADataset(\n",
        "    dataframe=validation_dataframe,\n",
        "    transform=validation_transforms\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 10. DATA LOADERS\n",
        "# ============================================================\n",
        "\n",
        "train_loader = DataLoader(\n",
        "    train_dataset,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    shuffle=True,\n",
        "    num_workers=2,\n",
        "    pin_memory=torch.cuda.is_available()\n",
        ")\n",
        "\n",
        "validation_loader = DataLoader(\n",
        "    validation_dataset,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    shuffle=False,\n",
        "    num_workers=2,\n",
        "    pin_memory=torch.cuda.is_available()\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 11. BASE-PAPER CNN MODEL\n",
        "# ============================================================\n",
        "\n",
        "class BasePaperCNN(nn.Module):\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        filters=(16, 32, 64),\n",
        "        dropout_rate=0.5\n",
        "    ):\n",
        "        super().__init__()\n",
        "\n",
        "        self.features = nn.Sequential(\n",
        "\n",
        "            # First convolution block\n",
        "            nn.Conv2d(\n",
        "                in_channels=3,\n",
        "                out_channels=filters[0],\n",
        "                kernel_size=3,\n",
        "                padding=1\n",
        "            ),\n",
        "\n",
        "            nn.ReLU(inplace=True),\n",
        "\n",
        "            nn.MaxPool2d(\n",
        "                kernel_size=2,\n",
        "                stride=2\n",
        "            ),\n",
        "\n",
        "            # Second convolution block\n",
        "            nn.Conv2d(\n",
        "                in_channels=filters[0],\n",
        "                out_channels=filters[1],\n",
        "                kernel_size=3,\n",
        "                padding=1\n",
        "            ),\n",
        "\n",
        "            nn.ReLU(inplace=True),\n",
        "\n",
        "            nn.MaxPool2d(\n",
        "                kernel_size=2,\n",
        "                stride=2\n",
        "            ),\n",
        "\n",
        "            # Third convolution block\n",
        "            nn.Conv2d(\n",
        "                in_channels=filters[1],\n",
        "                out_channels=filters[2],\n",
        "                kernel_size=3,\n",
        "                padding=1\n",
        "            ),\n",
        "\n",
        "            nn.ReLU(inplace=True),\n",
        "\n",
        "            nn.MaxPool2d(\n",
        "                kernel_size=2,\n",
        "                stride=2\n",
        "            ),\n",
        "\n",
        "            nn.Dropout(\n",
        "                p=dropout_rate\n",
        "            )\n",
        "        )\n",
        "\n",
        "        # Image dimension:\n",
        "        # 200 -> 100 -> 50 -> 25\n",
        "        flattened_features = (\n",
        "            filters[2] * 25 * 25\n",
        "        )\n",
        "\n",
        "        self.classifier = nn.Sequential(\n",
        "\n",
        "            nn.Flatten(),\n",
        "\n",
        "            nn.Linear(\n",
        "                flattened_features,\n",
        "                128\n",
        "            ),\n",
        "\n",
        "            nn.ReLU(inplace=True),\n",
        "\n",
        "            nn.Dropout(\n",
        "                p=dropout_rate\n",
        "            ),\n",
        "\n",
        "            # Binary output logit\n",
        "            nn.Linear(\n",
        "                128,\n",
        "                1\n",
        "            )\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        x = self.features(x)\n",
        "        x = self.classifier(x)\n",
        "\n",
        "        return x\n",
        "\n",
        "\n",
        "model = BasePaperCNN(\n",
        "    filters=FILTERS,\n",
        "    dropout_rate=DROPOUT_RATE\n",
        ").to(DEVICE)\n",
        "\n",
        "print(\"\\nModel:\")\n",
        "print(model)\n",
        "\n",
        "# ============================================================\n",
        "# 12. LOSS FUNCTION AND OPTIMIZER\n",
        "# ============================================================\n",
        "\n",
        "criterion = nn.BCEWithLogitsLoss()\n",
        "\n",
        "optimizer = optim.Adam(\n",
        "    model.parameters(),\n",
        "    lr=LEARNING_RATE\n",
        ")\n",
        "\n",
        "# ============================================================\n",
        "# 13. TRAINING FUNCTION\n",
        "# ============================================================\n",
        "\n",
        "def train_one_epoch(\n",
        "    model,\n",
        "    loader,\n",
        "    criterion,\n",
        "    optimizer,\n",
        "    device\n",
        "):\n",
        "    model.train()\n",
        "\n",
        "    total_loss = 0.0\n",
        "    total_correct = 0\n",
        "    total_samples = 0\n",
        "\n",
        "    for images, labels in loader:\n",
        "\n",
        "        images = images.to(device)\n",
        "\n",
        "        labels = labels.to(device)\n",
        "        labels = labels.view(-1, 1)\n",
        "\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        logits = model(images)\n",
        "\n",
        "        loss = criterion(\n",
        "            logits,\n",
        "            labels\n",
        "        )\n",
        "\n",
        "        loss.backward()\n",
        "\n",
        "        optimizer.step()\n",
        "\n",
        "        total_loss += (\n",
        "            loss.item() * images.size(0)\n",
        "        )\n",
        "\n",
        "        probabilities = torch.sigmoid(\n",
        "            logits\n",
        "        )\n",
        "\n",
        "        predictions = (\n",
        "            probabilities >= 0.5\n",
