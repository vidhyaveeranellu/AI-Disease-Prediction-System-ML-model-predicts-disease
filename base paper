        ")\n",
        "\n",
        "# ============================================================\n",
        "# 11. BASE-PAPER CNN MODEL\n",
        "# ============================================================\n",
        "\n",
        "class BasePaperCNN(nn.Module):\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        filters=(16, 32, 64),\n",
        "        dropout_rate=0.5\n",
        "    ):\n",
        "        super().__init__()\n",
        "\n",
        "        self.features = nn.Sequential(\n",
        "\n",
        "            # First convolution block\n",
        "            nn.Conv2d(\n",
        "                in_channels=3,\n",
        "                out_channels=filters[0],\n",
        "                kernel_size=3,\n",
        "                padding=1\n",
        "            ),\n",
        "\n",
        "            nn.ReLU(inplace=True),\n",
        "\n",
        "            nn.MaxPool2d(\n",
        "                kernel_size=2,\n",
        "                stride=2\n",
        "            ),\n",
        "\n",
        "            # Second convolution block\n",
        "            nn.Conv2d(\n",
        "                in_channels=filters[0],\n",
        "                out_channels=filters[1],\n",
        "                kernel_size=3,\n",
        "                padding=1\n",
        "            ),\n",
        "\n",
        "            nn.ReLU(inplace=True),\n",
        "\n",
        "            nn.MaxPool2d(\n",
        "                kernel_size=2,\n",
        "                stride=2\n",
        "            ),\n",
        "\n",
        "            # Third convolution block\n",
        "            nn.Conv2d(\n",
        "                in_channels=filters[1],\n",
        "                out_channels=filters[2],\n",
        "                kernel_size=3,\n",
        "                padding=1\n",
        "            ),\n",
        "\n",
        "            nn.ReLU(inplace=True),\n",
        "\n",
        "            nn.MaxPool2d(\n",
        "                kernel_size=2,\n",
        "                stride=2\n",
        "            ),\n",
        "\n",
        "            nn.Dropout(\n",
        "                p=dropout_rate\n",
        "            )\n",
        "        )\n",
        "\n",
        "        # Image dimension:\n",
        "        # 200 -> 100 -> 50 -> 25\n",
        "        flattened_features = (\n",
        "            filters[2] * 25 * 25\n",
        "        )\n",
        "\n",
        "        self.classifier = nn.Sequential(\n",
        "\n",
        "            nn.Flatten(),\n",
        "\n",
        "            nn.Linear(\n",
        "                flattened_features,\n",
        "                128\n",
        "            ),\n",
        "\n",
        "            nn.ReLU(inplace=True),\n",
        "\n",
        "            nn.Dropout(\n",
        "                p=dropout_rate\n",
        "            ),\n",
        "\n",
        "            # Binary output logit\n",
        "            nn.Linear(\n",
        "                128,\n",
        "                1\n",
        "            )\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        x = self.features(x)\n",
        "        x = self.classifier(x)\n",
        "\n",
        "        return x\n",
        "\n",
        "\n",
        "model = BasePaperCNN(\n",
        "    filters=FILTERS,\n",
        "    dropout_rate=DROPOUT_RATE\n",
        ").to(DEVICE)\n",
        "\n",
        "print(\"\\nModel:\")\n",
