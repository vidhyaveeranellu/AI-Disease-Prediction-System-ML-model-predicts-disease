        "\n",
        "# Install packages\n",
        "!pip install -q torch torchvision scikit-learn matplotlib seaborn pillow pandas\n",
        "\n",
        "# ============================================================\n",
        "# 1. IMPORT LIBRARIES\n",
        "# ============================================================\n",
